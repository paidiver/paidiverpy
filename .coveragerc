[run]
branch = True
source =
    src/paidiverpy
omit =
    src/paidiverpy/utils/benchmark_test.py
    generate_conda_meta.py
    tests/*

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    if __name__ == .__main__.:
    @deprecated
